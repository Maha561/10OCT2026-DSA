public class Main {
    public static void main(String[] args) {

        int n=5;


        for(int i=1;i<=5;i++){

            int start = n-i+1;
            int end =n+i-1;
            for(int j=1;j<=n*2-1;j++){

               if(j<=n-i){
                   System.out.print("  ");
               }

               if(j>=start&&j<=end){

                   System.out.print("* ");
               }




















            }
            System.out.println();
        }
    }
}
